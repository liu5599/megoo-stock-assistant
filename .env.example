# megoo股票助手 环境变量示例 —— 复制为 .env 并填入你的 Key
# cp .env.example .env

# DeepSeek API Key（AI 操盘日报用，不配则跳过日报生成）
DEEPSEEK_API_KEY=

# PushPlus token（微信推送：日报/预警/系统告警，https://www.pushplus.plus/ 获取）
WECHAT_PUSHPLUS=

# 可选：多通道推送（配了就走对应通道，与 PushPlus 并存）
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx   # 企业微信机器人
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx            # 飞书机器人

# 可选：Tushare Pro token（更稳定历史行情）
# TUSHARE_TOKEN=

# 股价预警引擎（可选，默认值已合理）
# MEGOO_ALERT_INTERVAL=60        # 轮询秒数
# MEGOO_ALERT_COOLDOWN_MIN=30    # 同规则推送冷却(分钟)
